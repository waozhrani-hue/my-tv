<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon for API 26+. Launchers mask the background to whatever
     shape the device uses, so the mark lives in the foreground layer inside
     the 66dp safe zone and the tile colour moves to the background layer. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
